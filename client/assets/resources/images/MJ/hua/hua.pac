{
  "__type__": "cc.AutoAtlas",
  "padding": 2,
  "maxWidth": 2048,
  "maxHeight": 2048,
  "filterMode": "linear",
  "wrapMode": "clamp",
  "allowRotation": false,
  "forceSquared": false,
  "powerOfTwo": false,
  "algorithm": "MaxRects",
  "format": "png",
  "quality": 80,
  "packAutoAtlas": true,
  "paddingBleeding": 2
}
